<?xml version="1.0" ?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>es.gobcan.istac.tableau</groupId>
	<artifactId>tableau</artifactId>
	<version>1.3.2-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>TABLEAU</name>
	<description>Web Data Connector para Tableau</description>

	<prerequisites>
		<maven>3.2.1</maven>
	</prerequisites>

	<properties>
		<java.version>1.8</java.version>
    	<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    	<!--MVN -->
        <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>
		<frontend-maven-plugin.version>1.6</frontend-maven-plugin.version>
		<node.version>v6.11.1</node.version>
		<yarn.version>v0.27.5</yarn.version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>${frontend-maven-plugin.version}</version>

				<configuration>
					<workingDirectory>src/main/resources/public</workingDirectory>
				</configuration>

				<executions>
					<execution>
						<id>install node and npm</id>
						<goals>
							<goal>install-node-and-yarn</goal>
						</goals>
						<configuration>
							<nodeVersion>${node.version}</nodeVersion>
							<yarnVersion>${yarn.version}</yarnVersion>
						</configuration>
					</execution>
					<execution>
						<id>yarn install</id>
						<goals>
							<goal>yarn</goal>
						</goals>
						<configuration>
							<arguments>install</arguments>
						</configuration>
					</execution>
					<execution>
						<id>yarn run build</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>yarn</goal>
						</goals>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>	
		</plugins>

		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.0.2</version>
					<configuration>
						<useDefaultDelimiters>false</useDefaultDelimiters>
						<delimiters>
							<delimiter>${resource.delimiter}</delimiter>
						</delimiters>
						<resources>
							<resource>
								<directory>src/main/resources/</directory>
								<excludes>
									<exclude>public/node_modules/**</exclude>
									<exclude>public/node/**</exclude>
									<exclude>package.json</exclude>
									<exclude>yarn.lock</exclude>
								</excludes>
							</resource>
						</resources>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-release-plugin</artifactId>
					<version>2.5.3</version>
					<configuration>
						<useReleaseProfile>false</useReleaseProfile>
						<tagNameFormat>${maven.build.timestamp}-v@{project.version}</tagNameFormat>
					</configuration>
				</plugin>				
			</plugins>
		</pluginManagement>
	</build>

	<scm>
		<connection>scm:git:http://git.arte-consultores.com/istac/tableau</connection>
		<developerConnection>scm:git:http://git.arte-consultores.com/istac/tableau</developerConnection>
		<url>http://git.arte-consultores.com/istac/tableau</url>
		<tag>HEAD</tag>
	</scm>

	<issueManagement>
		<system>Jira</system>
		<url>http://jira.arte-consultores.com/browse/TABLEAU</url>
	</issueManagement>

	<distributionManagement>
		<repository>
			<id>arte.releases.http</id>
			<name>Arte Repository - RELEASE</name>
			<url>http://repository.arte-consultores.com/content/repositories/releases</url>
		</repository>
		<snapshotRepository>
			<id>arte.snapshot.http</id>
			<name>Arte Repository - SNAPSHOT</name>
			<url>http://repository.arte-consultores.com/content/repositories/snapshots</url>
		</snapshotRepository>
	</distributionManagement>
</project>
